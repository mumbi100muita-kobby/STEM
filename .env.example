# Copy this file to .env and replace every placeholder.
# Never commit .env.

# Required. Use a long random value in development and production.
SECRET_KEY=replace-with-a-long-random-string

# Application config class: development | production
# Do not use the deprecated FLASK_ENV variable.
STEM_CONFIG=development

# Flask CLI debug flag (optional). 1 enables the debugger for local work.
FLASK_DEBUG=1

# PostgreSQL connection used for development and production.
# Tests ignore this and use an in-memory SQLite database instead.
# Example: postgresql+psycopg://stem:stem@localhost:5432/stem_dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/stem_dev
